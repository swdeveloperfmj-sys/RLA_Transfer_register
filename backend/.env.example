PORT=5000
MONGODB_URI=mongodb://localhost:27017/rla-transfer
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5175

# Web Push for installed phone app notifications. Generate once with:
# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=BEVCcN7pF1-Xan3MgoYvUyFFrwfZH283CKy5vbnmteEQsf_beGo47VhzXTib7stfrLNPL_u7aHob89nDVWTvyPc
VAPID_PRIVATE_KEY=IuUI5UlqPXmj_3R3rB-f4x_COHq_x2PYLRh_VJRU1X8

# SMTP configuration for automatic workflow emails (for example, Mailtrap, Gmail SMTP, or your company mail server)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-your-smtp-password
EMAIL_FROM="RLA Operations <notifications@example.com>"

# Persistent invoice storage in Cloudflare R2. Create an R2 API token scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rla-invoices
# Public custom domain (recommended) or the R2 development URL. Example: https://invoices.example.com
R2_PUBLIC_URL=

# Textware transactional SMS. Set ENABLED=true only after Textware supplies valid credentials and approves the sender ID.
TEXTWARE_SMS_ENABLED=false
TEXTWARE_SMS_URL=https://msg.text-ware.com/send_sms.php
TEXTWARE_SMS_USERNAME=
TEXTWARE_SMS_PASSWORD=
TEXTWARE_SMS_SENDER_ID=
